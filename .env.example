# HuggingFace 镜像与下载目录配置示例
# 复制为 .env 后按需修改（.env 已被 gitignore，不会被提交）

# 国内镜像端点（默认官方为 https://huggingface.co）
HF_ENDPOINT=https://hf-mirror.com

# 模型权重与数据集的默认下载目录
# Windows 路径 E:\ahuggingfaceload 在 WSL 中对应 /mnt/e/ahuggingfaceload
HF_HOME=/mnt/e/ahuggingfaceload

# 使用 Xet 高性能传输加速下载（hf-xet 已随 huggingface_hub 安装）
HF_XET_HIGH_PERFORMANCE=1
